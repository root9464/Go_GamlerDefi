+            'player_left': (p) => {showLog(`Игрок ${p.PlayerID} покинул игру.`, 'info'); delete players[p.PlayerID]; updatePlayerList(); updateGameBoard();},
+            'token_moved': (p) => {if (players[p.PlayerID]) {players[p.PlayerID].Position.X = p.Position.X; players[p.PlayerID].Position.Y = p.Position.Y; updateGameBoard();} },
+          }[message.type];
