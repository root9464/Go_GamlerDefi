+        socket.onclose = () => onDisconnect();
+        socket.onerror = (error) => {console.error("WebSocket Error:", error); showLog('Ошибка подключения', 'error'); onDisconnect();};
+        socket.onmessage = (event) => {
+          try {
+            const message = JSON.parse(event.data);
