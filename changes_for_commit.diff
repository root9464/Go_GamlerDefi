+      // ... (updatePlayerList, updateGameBoard, showLog, getColor... - без изменений)
+      function updatePlayerList() {playerList.innerHTML = ''; Object.values(players).forEach(p => {const li = document.createElement('li'); li.className = 'flex items-center gap-2 p-2 bg-gray-700 rounded'; li.innerHTML = `<div class="w-3 h-3 rounded-full bg-${getColorForUser(p.ID)}-500"></div><span>${p.ID} ${p.ID === myUserId ? '(Вы)' : ''} ${p.IsHost ? '👑' : ''}</span>`; playerList.appendChild(li);});}
+      function updateGameBoard() {gameBoard.querySelectorAll('.player-token').forEach(el => el.remove()); Object.values(players).forEach(p => {const token = document.createElement('div'); token.id = `player-${p.ID}`; token.className = 'player-token absolute w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm text-white border-2 border-white shadow-lg cursor-move'; token.style.left = `${p.Position.X}%`; token.style.top = `${p.Position.Y}%`; token.style.transform = 'translate(-50%, -50%)'; token.style.backgroundColor = getHexColorForUser(p.ID); token.textContent = p.ID.substring(0, 2); token.title = p.ID; gameBoard.appendChild(token);});}
+      function showLog(message, type = 'info') {const colors = {info: 'bg-gray-600', success: 'bg-green-600', error: 'bg-red-600', game: 'bg-cyan-600'}; const logEl = document.createElement('div'); logEl.className = `pointer-events-auto rounded-lg shadow-lg p-3 text-white text-sm ${colors[type]}`; logEl.textContent = message; logsContainer.appendChild(logEl); setTimeout(() => {logEl.style.transition = 'opacity 0.5s ease'; logEl.style.opacity = '0'; setTimeout(() => logEl.remove(), 500);}, 5000);}
+      const hexColorPalette = ['#ef4444', '#3b82f6', '#22c55e', '#eab308', '#6366f1', '#a855f7', '#ec4899'];
